[
  {
    "id": "E1_find_unknown_file",
    "question": "不知道函数在哪个文件。定位 can_execute 的定义，给出路径和行号。",
    "steps": [
      {
        "tool": "grep",
        "args": {
          "pattern": "def can_execute",
          "glob": "*.py"
        },
        "status": "success",
        "contains": [
          "/security.py:7: def can_execute(role, action):"
        ]
      },
      {
        "tool": "read_file",
        "args": {
          "file_path": "/security.py",
          "offset": 6,
          "limit": 2
        },
        "status": "success",
        "contains": [
          "7: def can_execute(role, action):",
          "8:     return action in ROLE_PERMISSIONS.get(role, set())"
        ]
      }
    ]
  },
  {
    "id": "E2_compare_code_and_docs",
    "question": "读取代码和 README，对比 reader 与 admin 权限描述是否一致，给出文件证据。",
    "steps": [
      {
        "tool": "read_file",
        "args": {
          "file_path": "/security.py",
          "offset": 1,
          "limit": 4
        },
        "status": "success",
        "contains": [
          "2: ROLE_PERMISSIONS = {",
          "3:     \"reader\": {\"read\"}",
          "4:     \"admin\": {\"read\", \"delete\"}"
        ]
      },
      {
        "tool": "read_file",
        "args": {
          "file_path": "/README.md",
          "offset": 2,
          "limit": 2
        },
        "status": "success",
        "contains": [
          "3: Reader can only read documents.",
          "4: Admin can read and delete documents."
        ]
      }
    ]
  },
